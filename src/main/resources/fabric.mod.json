{
  "schemaVersion": 1,
  "id": "neon-gen",
  "version": "${version}",
  "name": "Neon Gen",
  "description": "A mod that allows you to use neon gen accounts for Fabric",
  "authors": ["classloader"],
  "contact": {
    "homepage": "https://neonclient.com"
  },
  "environment": "client",
  "accessWidener": "neon-gen.classtweaker",
  "entrypoints": {
    "main": [
      "com.neonclient.entry.ModEntryPoint"
    ]
  },
  "mixins": [
    {
      "config": "neon-gen.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
